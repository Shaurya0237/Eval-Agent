# Required: OpenAI API key used by Hermes for every run (Hermes provider "openai-api").
OPENAI_API_KEY=

# Optional: port for the app (UI + API). Default 3000.
# PORT=3000

# Optional: how many Hermes runs execute at the same time. Default 2.
# EVAL_CONCURRENCY=2

# Optional: if you are behind a TLS-intercepting corporate proxy, point this at
# a CA bundle (PEM) so Hermes (Python) can reach api.openai.com. It is passed to
# Hermes as SSL_CERT_FILE / REQUESTS_CA_BUNDLE.
# EVAL_CA_BUNDLE=/path/to/ca-bundle.pem
